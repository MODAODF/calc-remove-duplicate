msgid "Remove Duplicates"
msgstr "移除重複項"

msgid "Remove Duplicates..."
msgstr "移除重複項..."

msgid "~Please select the duplicate columns (Press Ctrl to multiselect):"
msgstr "請選擇判斷重複的欄（按住 Ctrl 鍵可多重選取）(~P)："

msgid "Select ~All"
msgstr "全部選取(~A)"

msgid "~Selection includes title"
msgstr "選取區域包含了題名(~S)"

msgid "Progress"
msgstr "進度"

msgid "~OK"
msgstr "確定(~O)"

msgid "~Cancel"
msgstr "取消(~C)"

msgid "Column "
msgstr "欄 "

msgid "Do not support multiselection"
msgstr "不支援多重選取"

msgid "Please select a range"
msgstr "請選擇一個範圍"

msgid "Finished in "
msgstr "完成時間："

msgid " seconds."
msgstr " 秒"

msgid "We found and deleted "
msgstr "我們找到並刪除了"

msgid " duplicated values."
msgstr " 個重複的值。"

msgid "Now we have only "
msgstr "保留了 "

msgid " unique values."
msgstr " 不同的值。"

msgid "No duplicates found."
msgstr "沒有找到重複的值。"

msgid "Cancelled. "
msgstr "已取消。"

msgid "An error occurred! "
msgstr "發生錯誤！"

msgid "The changes will now be undone."
msgstr "變更將無法回復！"

msgid "No changes have been made."
msgstr "沒有做出任何改變。"
