<?xml version='1.0' encoding='UTF-8'?>
<oor:component-data
 xmlns:oor="http://openoffice.org/2001/registry"
 xmlns:xs="http://www.w3.org/2001/XMLSchema"
 oor:name="Addons"
 oor:package="org.openoffice.Office">
    <node oor:name="AddonUI">
        <node oor:name="OfficeToolbarMerging">
            <node oor:name="org.ossii.CalcRemoveDuplicates.OfficeToolbarMerging" oor:op="replace">
                <node oor:name="RD001" oor:op="replace">
                    <prop oor:name="MergeToolBar" oor:type="xs:string">
                        <value>standardbar</value>
                    </prop>
                    <!-- No real anchor: fall through to AddLast so the
                         button lands at the very end of the standard bar. -->
                    <prop oor:name="MergePoint">
                        <value>.uno:CalcRemoveDuplicatesAnchor</value>
                    </prop>
                    <prop oor:name="MergeCommand">
                        <value>AddAfter</value>
                    </prop>
                    <prop oor:name="MergeFallback">
                        <value>AddLast</value>
                    </prop>
                    <prop oor:name="MergeContext" oor:type="xs:string">
                        <value>com.sun.star.sheet.SpreadsheetDocument</value>
                    </prop>
                    <node oor:name="ToolBarItems">
                        <node oor:name="RD002" oor:op="replace">
                            <prop oor:name="URL" oor:type="xs:string">
                                <value>service:org.ossii.CalcRemoveDuplicates.do</value>
                            </prop>
                            <prop oor:name="Title" oor:type="xs:string">
                                <value xml:lang="en-US">Remove Duplicates...</value>
                                <value xml:lang="ru-RU">Удалить дубликаты...</value>
                                <value xml:lang="zh-CN">删除重复项...</value>
                                <value xml:lang="zh-TW">移除重複項...</value>
                            </prop>
                            <prop oor:name="Target" oor:type="xs:string">
                                <value>_self</value>
                            </prop>
                            <prop oor:name="Context" oor:type="xs:string">
                                <value>com.sun.star.sheet.SpreadsheetDocument</value>
                            </prop>
                        </node> <!-- RD002 -->
                    </node> <!-- ToolBarItems -->
                </node> <!-- RD001 -->
            </node>
        </node> <!-- OfficeToolbarMerging -->
        <node oor:name="OfficeMenuBarMerging">
            <node oor:name="org.ossii.CalcRemoveDuplicates.OfficeMenuBarMerging" oor:op="replace">
                <node oor:name="RD003" oor:op="replace">
                    <prop oor:name="MergePoint">
                        <value>.uno:DataMenu\.uno:FilterMenu</value>
                    </prop>
                    <prop oor:name="MergeCommand">
                        <value>AddAfter</value>
                    </prop>
                    <prop oor:name="MergeFallback">
                        <value>AddPath</value>
                    </prop>
                    <prop oor:name="MergeContext" oor:type="xs:string">
                        <value>com.sun.star.sheet.SpreadsheetDocument</value>
                    </prop>
                    <node oor:name="MenuItems">
                        <node oor:name="RD004" oor:op="replace">
                            <prop oor:name="URL" oor:type="xs:string">
                                <value>service:org.ossii.CalcRemoveDuplicates.do</value>
                            </prop>
                            <prop oor:name="Title" oor:type="xs:string">
                                <value xml:lang="en-US">Remove Duplicates...</value>
                                <value xml:lang="ru-RU">Удалить дубликаты...</value>
                                <value xml:lang="zh-CN">删除重复项...</value>
                                <value xml:lang="zh-TW">移除重複項...</value>
                            </prop>
                            <prop oor:name="Target" oor:type="xs:string">
                                <value>_self</value>
                            </prop>
                        </node> <!-- RD004 -->
                    </node> <!-- MenuItems -->
                </node> <!-- RD003 -->
            </node>
        </node> <!-- OfficeMenuBarMerging -->
        <node oor:name="Images">
            <node oor:name="org.ossii.CalcRemoveDuplicates.Image.RD005" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string">
                    <value>service:org.ossii.CalcRemoveDuplicates.do</value>
                </prop>
                <node oor:name="UserDefinedImages">
                    <prop oor:name="ImageSmallURL" oor:type="xs:string">
                        <value>%origin%/icons/image1_16.bmp</value>
                    </prop>
                    <prop oor:name="ImageBigURL" oor:type="xs:string">
                        <value>%origin%/icons/image1_26.bmp</value>
                    </prop>
                </node> <!-- UserDefinedImages -->
            </node> <!-- Image.RD005 -->
        </node> <!-- Images -->
    </node> <!-- AddonUI -->
</oor:component-data>
